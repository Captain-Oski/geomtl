NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# Tant que SITE_PUBLIC n'est pas "true", le public voit la page « Site en construction ».
# Le comité entre le code ci-dessous (lien « Accès comité ») pour voir le vrai site.
SITE_PUBLIC=false
CODE_ACCES_COMITE=un-code-long-a-partager-au-comite
# SITE_PUBLIC est lu à la compilation pour robots.txt et sitemap.xml : redéployer après l'avoir changé.

# Adresse publique du site : aperçus de partage, sitemap, robots.txt et invitations à l'admin.
NEXT_PUBLIC_SITE_URL=https://geomtl.com

# Demandes de réservation de kiosque (formulaire du plan, page Devenir partenaire)
# Courriels au comité (partenariat@) et au demandeur, envoyés par Gmail :
# compte Google Workspace info@ et mot de passe d'application (validation en
# deux étapes requise). Sans eux, les demandes sont enregistrées mais aucun courriel ne part.
GMAIL_UTILISATEUR=info@geomtl.com
GMAIL_MOT_DE_PASSE=mot-de-passe-d-application
# Expéditeur : un alias déclaré dans le Gmail de info@ (« Envoyer des e-mails en tant que »). Facultatif.
COURRIEL_EXPEDITEUR=GÉOMTL 2027 <partenariat@geomtl.com>
# Destinataire des avis de nouvelle demande. Facultatif : partenariat@geomtl.com par défaut.
# En local, mettre sa propre adresse pour ne pas écrire au comité pendant les tests.
COURRIEL_COMITE=
# Sel secret du hachage des adresses IP (limite d'envois) : une longue chaîne aléatoire.
DEMANDES_SEL=une-longue-chaine-aleatoire
