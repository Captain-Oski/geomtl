ernement du Canada."}],["$","p","5",{"className":"text-mid-gray leading-relaxed","children":"Nous remercions chaleureusement Ressources naturelles Canada pour cet engagement exemplaire envers le développement du géospatial canadien."}]]}]}],["$","aside",null,{"className":"space-y-6","children":[false,["$","div",null,{"className":"glass rounded-2xl p-5","children":[["$","h3",null,{"className":"text-sm font-bold text-white uppercase tracking-wider mb-4","children":"GeoMTL 2027"}],["$","p",null,{"className":"text-xs text-mid-gray mb-4","children":"14–15 octobre 2027 · Palais des congrès de Montréal"}],["$","$L2",null,{"href":"/fr/billetterie","className":"block w-full py-2.5 text-center text-sm font-bold text-white rounded-xl bg-gradient-to-r from-rose-geo to-orange-geo hover:opacity-90 transition-all","children":"Acheter un billet"}]]}]]}]]}]}]]}]],null],null]},["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children","actualites","children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children","actualites","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},["$L7",null],null]},[["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","html",null,{"lang":"fr","children":["$","body",null,{"style":{"background":"#0a1628","color":"#f0f4f8","fontFam